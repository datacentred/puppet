input {
    tcp {
        port   => <%= @logstash_beavertcp_port %>
        format => "json"
    },
    tcp { 
        port   => <%= @logstash_beaver_ssl_port %>
        format => "json"
        ssl_verify => true
        ssl_verify_ca => "/var/lib/puppet/ssl/certs/ca.pem"
        ssl_certificate => "/var/lib/puppet/ssl/certs/<%= @fqdn %>.pem"
        ssl_key => "/var/lib/puppet/ssl/private_keys/<%= @fqdn %>.pem"
    }
}
